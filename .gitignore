# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor backups
*.bak
*~
*.swp

# Python build/test artifacts (CLI tools)
__pycache__/
*.pyc
.pytest_cache/

# Claude Code working directory for this project — do not publish
.claude/

# Internal instructions for Claude Code (contain private paths/names) — do not publish
# Anchored to repo root so nested CLAUDE.md files (e.g. jig template docs) are still published
/CLAUDE.md

# Internal project notes and decisions — source-side, not part of the public showcase
# Anchored to repo root so nested docs/ (e.g. jig template tree) are still published
/docs/

# Secrets and local environment — do not publish
.env
.env.*
*.local

# Claude Code state and private data — in case anything from ~/.claude gets copied here
history.jsonl
projects/
sessions/
security/
telemetry/
usage-data/
daemon.log
