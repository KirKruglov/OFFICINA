{
  "effortLevel": "high",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch",
      "Bash(find *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(unzip -p *)",
      "Bash(head *)",
      "Bash(grep *)",
      "Bash(egrep *)",
      "Bash(fgrep *)",
      "Bash(rg *)",
      "Bash(ag *)",
      "Bash(cat *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git remote *)",
      "Bash(git ls-files *)",
      "Bash(git worktree list)",
      "Bash(git worktree add *)",
      "Bash(git worktree remove *)",
      "Bash(git worktree move *)",
      "Bash(git worktree prune)",
      "Bash(curl -s *)",
      "Bash(curl -sI *)",
      "Bash(curl -sL *)",
      "Bash(curl -fsSL *)"
