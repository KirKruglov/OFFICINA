#!/usr/bin/env python3
"""auto-commit — deterministic quick commit for small edits."""
import argparse
import os
import re
import subprocess
import sys

MAX_FILES = 3
SUBJECT_LIMIT = 72
LARGE_FILE_LIMIT = 1_000_000  # 1 MB

# File status from `git diff --name-status` → subject verb.
VERB = {"A": "add", "M": "update", "D": "remove", "R": "rename", "C": "add", "T": "update"}

SECRET_FILE_RE = re.compile(
    r"(^|/)(\.env($|\.)|.*\.pem$|.*\.key$|id_rsa.*|.*credentials.*|.*secret.*)", re.I
)
SECRET_CONTENT = [
    (re.compile(r"sk-[a-zA-Z0-9]{20,}"), "OpenAI/Anthropic key"),
    (re.compile(r"ghp_[A-Za-z0-9]{20,}"), "GitHub PAT"),
    (re.compile(r"xox[baprs]-[A-Za-z0-9-]{10,}"), "Slack token"),
    (re.compile(r"AWS_[A-Z_]+ ?= ?['\"][A-Za-z0-9/+=]{20,}"), "AWS key"),
    (re.compile(r"-----BEGIN[A-Z ]*PRIVATE KEY-----"), "private key"),
]

# Name looks like a secret but is a template or documentation — a real secret inside
# is still caught by the content patterns (SECRET_CONTENT) on added lines.
ALLOWED_SECRET_SUFFIXES = (".example", ".sample", ".template", ".dist")
DOC_EXT = (".md", ".txt", ".rst")


# --- Pure logic (tested without git) ---

def file_dir(path: str) -> str:
    """Parent directory of the file; empty string for a file at the repo root."""
    return os.path.dirname(path)


def check_gate(files: list[str], untracked: list[str] = ()) -> str | None:
    """Reason to refuse, or None if the set is within quick-edit bounds."""
    if not files:
        if untracked:
            return (
                f"no tracked changes, but {len(untracked)} new untracked file(s) — "
                "auto-commit does not commit them; use git add + the committing-changes skill"
            )
        return "no changes to commit"
    if len(files) > MAX_FILES:
        return (
            f"{len(files)} files changed (limit {MAX_FILES}) — "
            "set is wider than a quick edit, use the committing-changes skill"
        )
    dirs = {file_dir(f) for f in files}
    if len(dirs) >= 2:
        return (
            f"changes span {len(dirs)} directories — "
            "set is wider than a quick edit, use the committing-changes skill"
        )
    return None


def detect_scope(files: list[str]) -> str | None:
    """Scope — last segment of the common directory prefix; None if there is none."""
    dir_lists = [f.split("/")[:-1] for f in files]
    if not dir_lists:
        return None
    common = dir_lists[0]
    for d in dir_lists[1:]:
        n = 0
        while n < len(common) and n < len(d) and common[n] == d[n]:
            n += 1
        common = common[:n]
    return common[-1] if common else None


def derive_verb(statuses: list[str]) -> str:
    """Verb from git statuses: single status → its verb, mixed set → update."""
    verbs = {VERB.get(s[:1], "update") for s in statuses}
    return verbs.pop() if len(verbs) == 1 else "update"


def build_subject(verb: str, files: list[str]) -> str:
    names = [os.path.basename(f) for f in files]
    return f"{verb} " + ", ".join(names)


def compose(scope: str | None, subject: str, limit: int = SUBJECT_LIMIT) -> str:
    head = f"{scope}: {subject}" if scope else subject
    if len(head) > limit:
        head = head[:limit].rstrip(", ")
    return head


def name_allowed(path: str) -> bool:
    """Name matches a secret pattern but is a template or documentation — don't block by name."""
    return path.endswith(ALLOWED_SECRET_SUFFIXES + DOC_EXT)


def scan_secrets(diff: str, files: list[str]) -> list[str]:
    """List of secrets found; non-empty → hard refusal with no override."""
    hits: list[str] = []
    for f in files:
        if SECRET_FILE_RE.search(f) and not name_allowed(f):
            hits.append(f"suspicious file: {f}")
    for line in diff.splitlines():
        if line.startswith("+") and not line.startswith("+++"):
            for pat, name in SECRET_CONTENT:
                if pat.search(line):
                    hits.append(f"{name} in added lines")
    return list(dict.fromkeys(hits))  # preserve order, drop duplicates


def large_files(files: list[str]) -> list[str]:
    """Working-tree files larger than the limit — by actual on-disk size."""
    return [
        f for f in files
        if os.path.isfile(f) and os.path.getsize(f) > LARGE_FILE_LIMIT
    ]


# --- git I/O (the only layer with side effects) ---

def git(*args: str, check: bool = True) -> subprocess.CompletedProcess:
    try:
        r = subprocess.run(["git", *args], capture_output=True, text=True)
    except FileNotFoundError:
        die("git is required but was not found in PATH")
    if check and r.returncode != 0:
        die(f"git {' '.join(args)}: {r.stderr.strip()}")
    return r


def preflight() -> None:
    r = git("rev-parse", "--is-inside-work-tree", check=False)
    if r.returncode != 0 or r.stdout.strip() != "true":
        die("not a git repository")
    git_dir = git("rev-parse", "--git-dir").stdout.strip()
    if os.path.exists(os.path.join(git_dir, "MERGE_HEAD")):
        die("a merge is in progress — finish it manually")
    if current_branch() is None:
        die("detached HEAD — the commit would be unreachable; switch to a branch")


def current_branch() -> str | None:
    r = git("symbolic-ref", "--short", "-q", "HEAD", check=False)
    name = r.stdout.strip()
    return name if r.returncode == 0 and name else None


def has_commits() -> bool:
    return git("rev-parse", "--verify", "-q", "HEAD", check=False).returncode == 0


def tracked_changes() -> list[tuple[str, str]]:
    """[(status, path)] of changed tracked files vs HEAD — without mutating the index."""
    out = git("diff", "HEAD", "--name-status").stdout
    rows: list[tuple[str, str]] = []
    for ln in out.splitlines():
        if not ln.strip():
            continue
        parts = ln.split("\t")
        rows.append((parts[0], parts[-1]))  # for R/C the destination path is the last field
    return rows


def tracked_diff() -> str:
    return git("diff", "HEAD").stdout


def untracked_files() -> list[str]:
    out = git("ls-files", "--others", "--exclude-standard").stdout
    return [ln for ln in out.splitlines() if ln]


# --- Output and interaction ---

def die(msg: str) -> None:
    print(f"auto-commit: {msg}", file=sys.stderr)
    raise SystemExit(1)


def print_plan(files: list[str], head: str, untracked: list[str], bins: list[str]) -> None:
    print("Commit plan:", file=sys.stderr)
    for f in files:
        print(f"  + {f}", file=sys.stderr)
    print(f"  message: {head}", file=sys.stderr)
    if untracked:
        print("  untracked (not included): " + ", ".join(untracked), file=sys.stderr)
    if bins:
        print("  WARNING, large files (>1MB): " + ", ".join(bins), file=sys.stderr)


def confirm() -> bool:
    sys.stderr.write("Commit? (y/n) ")
    sys.stderr.flush()
    ans = sys.stdin.readline().strip().lower()
    return ans in ("y", "yes")


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="auto-commit",
        description="Deterministic quick commit for small edits (1-3 files, one directory).",
    )
    parser.add_argument("--dry-run", action="store_true", help="print the plan and exit without changing anything")
    parser.add_argument("-y", "--yes", action="store_true", help="skip the confirmation prompt")
    args = parser.parse_args()

    preflight()
    # Checks run on the full set of tracked changes BEFORE staging:
    # refusal, --dry-run and cancel leave the index untouched.
    changes = tracked_changes() if has_commits() else []
    files = [p for _, p in changes]
    statuses = [s for s, _ in changes]
    untracked = untracked_files()

    reason = check_gate(files, untracked)
    if reason:
        die(reason)

    secrets = scan_secrets(tracked_diff(), files)
    if secrets:
        die("secrets detected, commit blocked:\n  " + "\n  ".join(secrets))

    scope = detect_scope(files)
    head = compose(scope, build_subject(derive_verb(statuses), files))

    print_plan(files, head, untracked, large_files(files))

    if args.dry_run:
        return 0
    if not args.yes:
        if not sys.stdin.isatty():
            die("no TTY for confirmation; use -y for a non-interactive commit")
        if not confirm():
            print("auto-commit: cancelled", file=sys.stderr)
            return 1

    git("add", "-u")
    r = git("commit", "-m", head, check=False)
    if r.returncode != 0:
        print((r.stderr or r.stdout).strip(), file=sys.stderr)
        die("commit failed (a pre-commit hook may have failed) — fix and retry")

    sha = git("rev-parse", "--short", "HEAD").stdout.strip()
    print(f"{sha} {head}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
